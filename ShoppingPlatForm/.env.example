# ══════════════════════════════════════════
# Shopverse — Environment Variables
# ══════════════════════════════════════════
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Required (server will not start without these in production) ──
JWT_SECRET=your-secure-random-string-minimum-32-chars
ADMIN_PASSWORD=your-secure-admin-password

# ── Required in production ──
NODE_ENV=production
ALLOWED_ORIGIN=https://your-frontend-domain.com

# ── Optional ──
PORT=5001

# ── Client (Vite) ──
# Only VITE_ prefixed vars are exposed to the browser — keep secrets out.
# VITE_API_BASE_URL=https://api.your-domain.com
